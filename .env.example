POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial-control-db
# Optional JDBC params appended to the URL, e.g. "?sslmode=require" for managed databases
POSTGRES_PARAMS=

# Generate with "openssl rand -hex 32"
JWT_SECRET=change-to-new-secret-key
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_DAYS=14